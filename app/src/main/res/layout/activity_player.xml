<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg">

    <!-- 双色光晕背景（仅经典模式，默认隐藏） -->
    <com.jingxin.jingxinmusic.view.AuroraGradientView
        android:id="@+id/aurora_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 沉浸封面背景（封面原图铺满） -->
    <ImageView
        android:id="@+id/blur_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:visibility="gone" />

    <!-- 沉浸模式渐变遮罩 -->
    <com.jingxin.jingxinmusic.view.ImmersiveOverlayView
        android:id="@+id/immersive_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 沉浸模式夜间半透明黑色遮罩（压暗封面，保留色调） -->
    <View
        android:id="@+id/immersive_dark_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_semi_black"
        android:visibility="gone" />

    <!-- 白色遮罩层（白天模式非沉浸时使用，渐变由代码设置） -->
    <View
        android:id="@+id/white_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 半透明遮罩（夜间模式非沉浸时使用） -->
    <View
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dark_black" />

    <!-- 主内容：左侧信息区 -->
    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"        android:visibility="gone"
    >

        <!-- 封面占位（竖屏时留出封面空间） -->
        <View
            android:id="@+id/cover_placeholder"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:visibility="gone" />

        <!-- 歌名+歌手（SongTitleBar组件） -->
        <com.jingxin.jingxinmusic.view.SongTitleBar
            android:id="@+id/song_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 歌词 -->
        <com.jingxin.jingxinmusic.view.LyricView
            android:id="@+id/lyric_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- 频谱 -->
        <com.jingxin.jingxinmusic.view.SpectrumView
            android:id="@+id/spectrum_view"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <!-- 进度条（ProgressPanel组件，继承原progress_layout的margin与属性） -->
        <com.jingxin.jingxinmusic.view.ProgressPanel
            android:id="@+id/progress_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- 底部按钮（ControlBar组件，margin同旧control_buttons节点） -->
        <com.jingxin.jingxinmusic.view.ControlBar
            android:id="@+id/control_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

</FrameLayout>

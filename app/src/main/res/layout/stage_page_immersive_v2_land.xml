<?xml version="1.0" encoding="utf-8"?>
<!-- 沉浸风格页 V2 · 横屏（第6风格，完全自持实例）
     65/35 分栏 XML 固化：左信息流（标题/歌词/频谱/进度/控制）+ 右全高矩形封面
     封面自带前景边缘渐变（主色或光晕底色），左侧渐变过渡层衔接信息区底色 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iv2_page_root_land"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg">


    <!-- 主色遮罩层（横屏：左侧65%实底色板承担背景色，封面区内透明；旧沉浸横屏的背景正主） -->
    <com.jingxin.jingxinmusic.view.ImmersiveOverlayView
        android:id="@+id/iv2_mask_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />




    <!-- 精简模式触摸层 -->
    <View
        android:id="@+id/iv2_hide_touch_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 右：封面列（全高矩形封面贴右边缘；页面根直接子级跨全屏高，不被底部三件压缩）
         宽度由代码设 35%屏宽 marginEnd=0 靠右；仅横屏布局使用 -->
    <FrameLayout
        android:id="@+id/iv2_cover_col_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:clipToPadding="false">

        <com.jingxin.jingxinmusic.view.RotatingCoverView
            android:id="@+id/iv2_cover_land"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </FrameLayout>



    <!-- 渐变过渡层（叠封面左缘之上；旧 moveCoverBelowOverlay 顶层地位） -->
    <com.jingxin.jingxinmusic.view.LandscapeGradientOverlay
        android:id="@+id/iv2_gradient_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 夜间暗层（盖封面/渐变层之上、光晕之下：压暗封面右缘融入夜色） -->
    <View
        android:id="@+id/iv2_dark_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dark_black"
        android:visibility="gone" />
    <!-- 光晕氛围层（横屏沉浸：整屏叠加在封面/渐变层之上，透明底无左右界限；
         等价旧 ensureAuroraAboveCover 层级，V2 固化为 XML 声明顺序） -->
    <com.jingxin.jingxinmusic.view.AuroraGradientView
        android:id="@+id/iv2_aurora_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <!-- 主体：左65信息流（标题+歌词）+ 底部全宽三件（频谱/进度/控制） -->
    <LinearLayout
        android:id="@+id/iv2_main_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/iv2_info_land"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.jingxin.jingxinmusic.view.SongTitleBar
                android:id="@+id/iv2_title_land"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.jingxin.jingxinmusic.view.LyricView
                android:id="@+id/iv2_lyric_land"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />
        </LinearLayout>

        <!-- 底部全宽三件：占页面整体宽度 -->
        <com.jingxin.jingxinmusic.view.SpectrumView
            android:id="@+id/iv2_spectrum_land"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <com.jingxin.jingxinmusic.view.ProgressPanel
            android:id="@+id/iv2_progress_land"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <com.jingxin.jingxinmusic.view.ControlBar
            android:id="@+id/iv2_control_land"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <com.jingxin.jingxinmusic.view.PlayerTopBar
        android:id="@+id/iv2_top_bar_land"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />


</FrameLayout>

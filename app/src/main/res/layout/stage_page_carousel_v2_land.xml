<?xml version="1.0" encoding="utf-8"?>
<!-- 轮播风格页 V2 · 横屏（第8风格，独立骨架，非经典 65/35 分栏）
     结构对齐旧轮播横屏：卡片层置顶全宽（cv2_carousel_land，topMargin=顶栏高代码设）
     + 信息流满宽（标题在卡片下方，topMargin 代码设）+ 歌词 weight + 底部三件全宽
     父类绑定 id 全部保留（cover_col 默认收起，防父类空引用） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v2_page_root_land"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg">

    <!-- ===== 背景栈（本页私有，四态）===== -->
    <com.jingxin.jingxinmusic.view.AuroraGradientView
        android:id="@+id/v2_aurora_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/v2_blur_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:visibility="gone" />


    <View
        android:id="@+id/v2_dark_mask_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dark_black"
        android:visibility="gone" />

    <!-- ===== 精简模式触摸拦截层 ===== -->
    <View
        android:id="@+id/v2_hide_touch_layer_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ===== 封面列（父类绑定依赖，轮播默认收起；圆形封面/圆环不参与本风格）===== -->
    <FrameLayout
        android:id="@+id/v2_cover_col_land"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <com.jingxin.jingxinmusic.view.RotatingCoverView
            android:id="@+id/v2_cover_land"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/tv_focus_round" />

        <com.jingxin.jingxinmusic.view.SpectrumView
            android:id="@+id/v2_spectrum_ring_land"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== 信息流（满宽垂直流：标题+歌词+底部三件；标题 topMargin 代码设顶到卡片下）===== -->
    <LinearLayout
        android:id="@+id/v2_info_flow_land"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <com.jingxin.jingxinmusic.view.SongTitleBar
            android:id="@+id/v2_title_land"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.jingxin.jingxinmusic.view.LyricView
            android:id="@+id/v2_lyric_land"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <com.jingxin.jingxinmusic.view.SpectrumView
            android:id="@+id/v2_spectrum_land"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <com.jingxin.jingxinmusic.view.ProgressPanel
            android:id="@+id/v2_progress_land"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <com.jingxin.jingxinmusic.view.ControlBar
            android:id="@+id/v2_control_land"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- ===== 卡片轮播层（本风格专属：全宽置顶，topMargin=顶栏高、高度=28%H 代码动态设）===== -->
    <com.jingxin.jingxinmusic.view.CoverCarouselView
        android:id="@+id/cv2_carousel_land"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal|top" />

    <com.jingxin.jingxinmusic.view.PlayerTopBar
        android:id="@+id/v2_top_bar_land"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />


</FrameLayout>

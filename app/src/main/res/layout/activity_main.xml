<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 动态背景层（春意盎然风格生效，其他风格隐藏） -->
    <com.jingxin.jingxinmusic.view.DynamicBgView
        android:id="@+id/dynamic_bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 顶部栏 -->
    <FrameLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/close_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_power"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/help_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_settings"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </FrameLayout>

    <!-- 标题栏底部霓虹绿渐变线 -->
    <View
        android:id="@+id/title_accent_line"
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <!-- Tab 栏（仿 QQ Music 高品质页：小标题+大标题+底部指示线） -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 本地 -->
        <LinearLayout
            android:id="@+id/tab_local"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tab_local_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCAL"
                android:textSize="6sp"
                android:singleLine="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tab_local_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:text="本地"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- B站 -->
        <LinearLayout
            android:id="@+id/tab_bili"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tab_bili_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BILIBILI"
                android:textSize="6sp"
                android:singleLine="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tab_bili_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:text="B站"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- WebDAV -->
        <LinearLayout
            android:id="@+id/tab_cloud"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tab_cloud_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLOUD"
                android:textSize="6sp"
                android:singleLine="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tab_cloud_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:text="WebDAV"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 收藏 -->
        <LinearLayout
            android:id="@+id/tab_favorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tab_favorite_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAVORITE"
                android:textSize="6sp"
                android:singleLine="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tab_favorite_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:text="收藏"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Tab 底部指示线区域（底线 + 滑动指示器） -->
    <FrameLayout
        android:id="@+id/tab_indicator_container"
        android:layout_width="match_parent"
        android:layout_height="4dp">

        <!-- 全宽底线 -->
        <View
            android:id="@+id/tab_bottom_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical" />

        <!-- 滑动指示器 -->
        <View
            android:id="@+id/tab_indicator"
            android:layout_width="39dp"
            android:layout_height="3dp"
            android:layout_gravity="center_vertical|start" />
    </FrameLayout>

    <!-- Tab 指示线占位（隐藏） -->
    <LinearLayout
        android:id="@+id/tab_indicator_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/indicator_local"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/indicator_cloud"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/indicator_bili"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/indicator_favorite"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ========== 本地/云端 公共浏览区 ========== -->
    <LinearLayout
        android:id="@+id/browse_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 路径栏（本地子目录/云端共用） -->
        <LinearLayout
        android:id="@+id/path_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_navigate_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tv_browse_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />

            <ImageView
                android:id="@+id/btn_webdav_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:src="@drawable/ic_settings_new"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_bili_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:src="@drawable/ic_settings_new"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 网格卡片 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_browse"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- WebDAV未配置引导 -->
        <LinearLayout
            android:id="@+id/webdav_setup_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_cloud"
                android:alpha="0.4" />

            <TextView
                android:id="@+id/tv_webdav_setup_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配置WebDAV以浏览云端音乐"
                android:textSize="16sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/btn_go_webdav_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去配置"
                android:textSize="16sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- 加载中 -->
        <LinearLayout
            android:id="@+id/loading_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在加载..."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 收藏区 ========== -->
    <LinearLayout
        android:id="@+id/favorite_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 搜索栏 + 数量 同一行 -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="搜索歌曲或歌手..."
                android:textSize="14sp"
                android:inputType="text" />

            <TextView
                android:id="@+id/tv_song_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0 首收藏"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 收藏歌曲列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_song_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- 版权信息 -->
    <TextView
        android:id="@+id/tv_copyright"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="心静，音自清 · v1.0.7.5"
        android:textSize="11sp" />

    <!-- Mini 播放条 -->
    <FrameLayout
        android:id="@+id/mini_player_wrap"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:visibility="gone">

        <!-- 顶部流光线 -->
        <View
            android:id="@+id/mini_shimmer_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top" />

        <LinearLayout
            android:id="@+id/mini_player"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

        <!-- 迷你播放条圆形封面 -->
        <ImageView
            android:id="@+id/mini_cover"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_icon"/>

        <LinearLayout
            android:id="@+id/mini_player_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/mini_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    </FrameLayout>

    <!-- 加载中提示 -->
    <TextView
        android:id="@+id/tv_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在扫描音乐..."
        android:textSize="14sp"
        android:visibility="gone" />

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 轮播风格页面（组件化第5步）：三槽骨架
     底部三件（频谱/进度/控制条）共享单实例经 re-parent 借入底部槽位；
     标题/歌词/占位仍留在旧 info_panel 垂直流（与旧版布局字节级一致），
     页面只接管底部区域的所有权与皮肤底槽宿主 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/carousel_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 底槽：皮肤宿主容器（光晕/遮罩层由 BackgroundSkinController re-parent 于此） -->
    <FrameLayout
        android:id="@+id/carousel_bottom_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部簇：弹力占位(weight)之上，频谱/进度/控制条依次底钉 -->
    <LinearLayout
        android:id="@+id/carousel_bottom_cluster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 弹力占位：吸收全部剩余高度，把底下三槽钉到屏幕底部 -->
        <View
            android:id="@+id/carousel_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 频谱槽（共享 SpectrumView 经 re-parent 借入） -->
        <FrameLayout
            android:id="@+id/carousel_spectrum_slot"
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <!-- 进度槽（共享 ProgressPanel 经 re-parent 借入） -->
        <FrameLayout
            android:id="@+id/carousel_progress_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 控制条槽（共享 ControlBar 经 re-parent 借入） -->
        <FrameLayout
            android:id="@+id/carousel_control_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>

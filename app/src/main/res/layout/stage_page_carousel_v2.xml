<?xml version="1.0" encoding="utf-8"?>
<!-- 轮播风格页 V2 · 竖屏（第8风格，完全自持实例，骨架独立于新经典）
     与经典版差异：封面区（cover_area）默认收起，卡片轮播层（cv2_carousel）
     直接挂页根顶部（旧轮播：全宽居中、topMargin=顶栏+10dp 代码设）
     父类绑定 id 全部保留（cover_area 内封面/圆环默认 GONE，防父类空引用） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v2_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg">

    <!-- ===== 背景栈（本页私有，四态：默认日/夜 + 光晕日/夜）===== -->
    <com.jingxin.jingxinmusic.view.AuroraGradientView
        android:id="@+id/v2_aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/v2_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:visibility="gone" />

    <View
        android:id="@+id/v2_light_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0.7"
        android:visibility="gone" />

    <View
        android:id="@+id/v2_dark_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dark_black"
        android:visibility="gone" />

    <!-- ===== 精简模式触摸拦截层 ===== -->
    <View
        android:id="@+id/v2_hide_touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ===== 信息流（全宽垂直流：占位+标题+歌词+频谱+进度+控制条）=====
         占位高度代码设=卡片顶距+容器高；标题题距 26dp 代码设（旧轮播公式） -->
    <LinearLayout
        android:id="@+id/v2_info_flow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/v2_cover_placeholder"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.jingxin.jingxinmusic.view.SongTitleBar
            android:id="@+id/v2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.jingxin.jingxinmusic.view.LyricView
            android:id="@+id/v2_lyric"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <com.jingxin.jingxinmusic.view.SpectrumView
            android:id="@+id/v2_spectrum"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <com.jingxin.jingxinmusic.view.ProgressPanel
            android:id="@+id/v2_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <com.jingxin.jingxinmusic.view.ControlBar
            android:id="@+id/v2_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- ===== 封面区（父类绑定依赖，轮播默认收起；圆形封面/圆环频谱不参与本风格）===== -->
    <FrameLayout
        android:id="@+id/v2_cover_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <com.jingxin.jingxinmusic.view.RotatingCoverView
            android:id="@+id/v2_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/tv_focus_round" />

        <com.jingxin.jingxinmusic.view.SpectrumView
            android:id="@+id/v2_spectrum_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== 卡片轮播层（本风格专属：全宽置顶，尺寸/贴边距代码动态设）===== -->
    <com.jingxin.jingxinmusic.view.CoverCarouselView
        android:id="@+id/cv2_carousel"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal|top" />

    <!-- ===== 顶栏（全5键）===== -->
    <LinearLayout
        android:id="@+id/v2_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/v2_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/tv_focus_round"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/v2_btn_effect"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_effect"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/tv_focus_round"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <View
            android:id="@+id/v2_top_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/v2_right_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/v2_btn_lyric_search"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:src="@drawable/ic_lyric_search"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_round"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/v2_btn_spectrum"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:src="@drawable/ic_spectrum"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_round"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/v2_btn_outfit"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:src="@drawable/ic_outfit"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_round"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
